# Copy to /etc/drone-multi-sensor.env and fill in for a systemd deployment
# (see drone-multi-sensor.service). Full variable reference is the
# "Configuration" table in the README -- these are just the ones that
# actually matter to set for a real deployment; everything else has a
# working default.

DRONE_HOST=0.0.0.0
DRONE_PORT=8000
DRONE_DATABASE_URL=postgresql+psycopg2://drone:CHANGE_ME@127.0.0.1:5432/drone_sensor
DRONE_LOG_FORMAT=json

# REQUIRED before this is reachable from anywhere but 127.0.0.1 -- see the
# README's "Security & access control" section for the role each key gets.
DRONE_API_KEYS={"REPLACE_WITH_A_LONG_RANDOM_STRING": "admin"}

# Optional: uncomment and configure any of these you actually want.
# DRONE_WEBHOOK_URLS=
# DRONE_SLACK_WEBHOOK_URL=
# DRONE_PAGERDUTY_ROUTING_KEY=
# DRONE_DETECTION_RETENTION_DAYS=90
