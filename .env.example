# Copy to .env and edit before `docker compose up` -- compose reads .env
# automatically. Everything here has a fallback in docker-compose.yml, but
# DRONE_API_KEYS defaulting to empty means the API is wide open once
# exposed beyond localhost, so set it for any real deployment.

POSTGRES_PASSWORD=change-me
DRONE_PORT=8000

# JSON object mapping each key to a role (ingest/viewer/operator/admin) --
# see the README's "Security & access control" section.
DRONE_API_KEYS={"REPLACE_WITH_A_LONG_RANDOM_STRING": "admin"}

DRONE_LOG_FORMAT=json
DRONE_DETECTION_RETENTION_DAYS=0
DRONE_WEBHOOK_URLS=

# Only needed if you uncomment the caddy service in docker-compose.yml.
# DRONE_DOMAIN=drones.example.com
